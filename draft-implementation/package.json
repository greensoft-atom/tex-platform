{
  "name": "tex-draft-implementation",
  "version": "1.0.0",
  "private": true,
  "description": "Draft backend data layer (Mongoose 5.13 models and services) and its compatibility checks on Node.js 12.4.0 with MongoDB 4.4 / 5.0 (see docs 06 and 11).",
  "engines": {
    "node": "12.4.0",
    "npm": "6.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node tests/smoke.js",
    "db:migrate": "migrate-mongo up",
    "db:indexes": "node dist/scripts/sync-indexes.js",
    "db:indexes:check": "node dist/scripts/sync-indexes.js --check",
    "test:mongo": "node tests/test-mongo.js && node tests/test-documents.js && node tests/test-policy.js",
    "test:search": "node tests/test-search.js",
    "test:icu": "NODE_ICU_DATA=node_modules/full-icu node tests/test-icu.js"
  },
  "dependencies": {
    "@casl/ability": "5.4.4",
    "@casl/mongoose": "5.0.0",
    "@elastic/elasticsearch": "7.17.14",
    "@nestjs/common": "8.4.7",
    "@nestjs/core": "8.4.7",
    "@nestjs/platform-express": "8.4.7",
    "@pdf-lib/fontkit": "1.1.1",
    "ali-oss": "6.21.0",
    "aws-sdk": "2.1692.0",
    "axios": "0.34.0",
    "bcryptjs": "2.4.3",
    "bull": "3.29.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.13.2",
    "connect-mongo": "3.2.0",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.13",
    "ejs": "3.1.10",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "5.5.1",
    "express-session": "1.18.1",
    "full-icu": "1.5.0",
    "helmet": "4.6.0",
    "jest": "27.5.1",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "meilisearch": "0.25.1",
    "migrate-mongo": "8.2.3",
    "mocha": "9.2.2",
    "mongoose": "5.13.23",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "nodemailer": "6.9.16",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pino": "6.14.0",
    "prom-client": "14.2.0",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "sanitize-html": "2.13.1",
    "uuid": "8.3.2",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/mongodb": "3.6.20",
    "@types/node": "12.20.55",
    "typescript": "5.6.3"
  }
}
